{
  "name": "atem",
  "productName": "Atem",
  "version": "1.2.0",
  "description": "Atem – dein ruhiger Pausen-Begleiter für Windows und macOS.",
  "main": "src/main/main.js",
  "author": "Christoph Zgraggen",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs && electron . --dev",
    "preview": "node scripts/build.mjs && node scripts/preview-server.mjs",
    "test": "node --test \"test/*.test.*\"",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && node scripts/dist.mjs",
    "dist:win": "npm run build && node scripts/dist.mjs --win",
    "dist:mac": "npm run build && node scripts/dist.mjs --mac"
  },
  "build": {
    "appId": "ch.chriggi.atem",
    "productName": "Atem",
    "copyright": "© 2026 Christoph Zgraggen",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "!src/main/selftest.js",
      "src/shared/**",
      "src/preload/**",
      "dist/**",
      "build/icon-win.png",
      "package.json"
    ],
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon-win.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Atem",
      "artifactName": "Atem-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "artifactName": "Atem-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@resvg/resvg-js": "2.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "gsap": "3.15",
    "three": "^0.186.1"
  }
}
